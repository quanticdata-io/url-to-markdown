{
  "name": "@quanticdata/url-to-markdown",
  "version": "0.1.0",
  "description": "Turn any URL or HTML into clean Markdown for LLMs and RAG. Runs locally with no API key; optional QuanticData backend for JavaScript-heavy or blocked pages.",
  "keywords": [
    "markdown",
    "html-to-markdown",
    "url-to-markdown",
    "web-to-markdown",
    "readability",
    "llm",
    "rag",
    "chunking",
    "web-scraping",
    "crawler",
    "sitemap",
    "cli",
    "ai-agents"
  ],
  "homepage": "https://github.com/quanticdata-io/url-to-markdown#readme",
  "bugs": {
    "url": "https://github.com/quanticdata-io/url-to-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanticdata-io/url-to-markdown.git"
  },
  "license": "MIT",
  "author": "QuanticData <hello@quanticdata.io>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "url-to-markdown": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16",
    "demo-server": "tsx test/server.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.71",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "publint": "^0.3.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
